// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Session {
  id        String   @id
  sid       String   @unique
  data      String
  expiresAt DateTime

  @@map(name: "session")
}

model Game {
  id          Int           @id @default(autoincrement())
  username    String        @default("anonymous")
  start_time  DateTime      @default(now())
  end_time    DateTime?
  scene       Scene         @relation(fields: [scene_id], references: [id], onDelete: Cascade)
  scene_id    Int
  gameAnswers Game_Answer[]

  @@map(name: "game")
}

model Game_Answer {
  game           Game          @relation(fields: [game_id], references: [id], onDelete: Cascade)
  game_id        Int
  location_x     Float
  location_y     Float

  character_name CharacterName @relation(fields: [character], references: [character], onDelete: Cascade)
  character      Character

  @@unique([game_id, character])
  @@map(name: "game_answer")
}

model Scene {
  id      Int      @id @default(autoincrement())
  url     String   @unique
  answers Answer[]
  games   Game[]

  @@map(name: "scene")
}

model Answer {
  scene          Scene         @relation(fields: [scene_id], references: [id], onDelete: Cascade)
  scene_id       Int
  character_name CharacterName @relation(fields: [character], references: [character], onDelete: Cascade)
  character      Character
  location_x     Float
  location_y     Float

  @@unique([scene_id, character])
  @@map(name: "answer")
}

model CharacterName {
  character   Character     @unique
  name        String
  answers     Answer[]
  gameAnswers Game_Answer[]

  @@map(name: "character_name")
}

enum Character {
  ODLAW
  WALDO
  WIZARD_WHITEBEARD

  @@map(name: "character")
}
