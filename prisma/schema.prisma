// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Session {
  id        String   @id
  sid       String   @unique
  data      String
  expiresAt DateTime

  @@map(name: "session")
}

model Scene {
  id      Int      @id @default(autoincrement())
  url     String
  answers Answer[]

  @@map(name: "scene")
}

model Answer {
  scene         Scene  @relation(fields: [scene_id], references: [id], onDelete: Cascade)
  scene_id       Int    
  character     Character
  location_x     Float
  location_y     Float

  @@unique([scene_id, character])
  @@map(name: "answer")
}

model CharacterName {
  character Character @unique
  name  String
  @@map(name: "character_name")
}

enum Character {
  ODLAW
  WALDO
  WIZARD_WHITEBEARD

  @@map(name: "character" )
}